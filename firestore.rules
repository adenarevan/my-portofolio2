rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBotWorker() {
      return request.auth != null
        && exists(/databases/$(database)/documents/portfolioBotWorkers/$(request.auth.uid))
        && get(/databases/$(database)/documents/portfolioBotWorkers/$(request.auth.uid)).data.enabled == true;
    }
    function adminUid(uid) {
      return uid is string && get(/databases/$(database)/documents/portfolioBlogAdmins/$(uid)).data.enabled == true;
    }
    function isPortfolioBlogAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/portfolioBlogAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/portfolioBlogAdmins/$(request.auth.uid)).data.enabled == true;
    }
    function todayKey() {
      let local = request.time + duration.value(7, 'h');
      return string(local.year()) + '-' + string(local.month()) + '-' + string(local.day());
    }
    function autoPublication(postId) {
      let settings = get(/databases/$(database)/documents/portfolioBotSettings/main).data;
      let daily = getAfter(/databases/$(database)/documents/portfolioBotDaily/$(todayKey())).data;
      return settings.enabled == true && settings.get('autoPublish', false) == true
        && request.resource.data.authorId == settings.authorId
        && request.resource.data.publishedAt == request.time
        && request.resource.data.bot.publicationDay == todayKey()
        && daily.postIds.hasAny([postId]) && daily.postIds.size() <= settings.get('dailyTarget', 2);
    }
    function isValidPortfolioPost() {
      let p = request.resource.data;
      return p.keys().hasAll(['title', 'excerpt', 'body', 'tag', 'status', 'authorId', 'createdAt', 'updatedAt', 'publishedAt'])
        && p.keys().hasOnly(['title', 'excerpt', 'body', 'tag', 'status', 'authorId', 'createdAt', 'updatedAt', 'publishedAt', 'slug', 'metaDescription', 'sources', 'bot', 'searchTokens'])
        && (!('searchTokens' in p) || (p.searchTokens is list && p.searchTokens.size() <= 240))
        && p.title is string && p.title.size() > 0 && p.title.size() <= 140
        && p.body is string && p.body.size() > 0 && p.body.size() <= 50000
        && p.excerpt is string && p.excerpt.size() <= 320
        && p.tag is string && p.tag.size() <= 40
        && (!('slug' in p) || (p.slug is string && p.slug.size() <= 160 && (p.slug == '' || p.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$'))))
        && (!('metaDescription' in p) || (p.metaDescription is string && p.metaDescription.size() <= 160))
        && p.status in ['draft', 'published']
        && p.authorId is string && p.createdAt is timestamp
        && p.updatedAt == request.time
        && (p.publishedAt == null || p.publishedAt is timestamp)
        && (p.status != 'published' || p.publishedAt is timestamp);
    }
    match /portfolioBlogAdmins/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isBotWorker();
      allow list, write: if false;
    }
    match /portfolioBotWorkers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /portfolioBlogTopics/{id} {
      allow get: if id == 'main';
      allow create, update: if id == 'main' && (isPortfolioBlogAdmin() || isBotWorker())
        && request.resource.data.keys().hasOnly(['tags', 'updatedAt'])
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 200
        && request.resource.data.tags.size() == request.resource.data.tags.toSet().size()
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
    match /portfolioPosts/{postId} {
      allow get: if isPortfolioBlogAdmin() || isBotWorker() || resource.data.status == 'published';
      allow list: if isPortfolioBlogAdmin() || (isBotWorker() && request.query.limit <= 200) || (resource.data.status == 'published' && request.query.limit <= 20);
      allow create: if (isPortfolioBlogAdmin() && isValidPortfolioPost()
        && !('bot' in request.resource.data) && !('sources' in request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.publishedAt == null || request.resource.data.publishedAt == request.time))
        || (isBotWorker() && isValidPortfolioPost()
          && ((request.resource.data.status == 'draft' && request.resource.data.publishedAt == null)
            || (request.resource.data.status == 'published' && autoPublication(postId)))
          && request.resource.data.createdAt == request.time
          && adminUid(request.resource.data.authorId)
          && request.resource.data.bot.workerId == request.auth.uid
          && request.resource.data.bot.generatedAt == request.time
          && request.resource.data.bot.topicKey.matches('^[a-f0-9]{32}$')
          && postId == 'bot_' + request.resource.data.bot.topicKey
          && request.resource.data.sources is list && request.resource.data.sources.size() >= 2 && request.resource.data.sources.size() <= 3);
      allow update: if isPortfolioBlogAdmin() && isValidPortfolioPost()
        && request.resource.data.get('bot', null) == resource.data.get('bot', null)
        && request.resource.data.get('sources', null) == resource.data.get('sources', null)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.publishedAt == resource.data.publishedAt
          || (resource.data.publishedAt == null && request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time));
      allow delete: if isPortfolioBlogAdmin();
    }
    function validBotSettings() {
      let p = request.resource.data;
      return p.keys().hasAll(['enabled', 'categories', 'region', 'windowHours', 'time', 'timeZone', 'days', 'maxArticles', 'sourceIds', 'authorId', 'revision', 'updatedBy', 'updatedAt'])
        && p.keys().hasOnly(['enabled', 'autoPublish', 'dailyTarget', 'categories', 'region', 'windowHours', 'time', 'timeZone', 'days', 'maxArticles', 'sourceIds', 'authorId', 'revision', 'updatedBy', 'updatedAt'])
        && p.get('autoPublish', false) is bool && p.get('dailyTarget', 2) is int && p.get('dailyTarget', 2) >= 1 && p.get('dailyTarget', 2) <= 3
        && p.enabled is bool && p.region in ['ID', 'GLOBAL'] && p.windowHours in [6, 12, 24, 72, 168]
        && p.categories is list && p.categories.size() > 0 && p.categories.size() == p.categories.toSet().size() && p.categories.hasOnly(['all', 'ai', 'technology', 'programming', 'news', 'business', 'sports', 'science', 'entertainment'])
        && p.time is string && p.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && p.timeZone == 'Asia/Jakarta'
        && p.days is list && p.days.size() > 0 && p.days.size() == p.days.toSet().size() && p.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && p.maxArticles is int && p.maxArticles >= 1 && p.maxArticles <= 3
        && p.sourceIds is list && p.sourceIds.size() == p.sourceIds.toSet().size() && p.sourceIds.hasOnly(['antara', 'cnn', 'cnbc', 'techcrunch', 'verge', 'antara-news', 'cnn-news', 'cnbc-news'])
        && (p.region == 'ID' ? p.sourceIds.hasAny(['antara', 'antara-news']) && p.sourceIds.hasAny(['cnn', 'cnbc', 'cnn-news', 'cnbc-news'])
          : (p.sourceIds.hasAny(['antara', 'antara-news']) ? 1 : 0) + (p.sourceIds.hasAny(['cnn', 'cnbc', 'cnn-news', 'cnbc-news']) ? 1 : 0) + (p.sourceIds.hasAny(['techcrunch']) ? 1 : 0) + (p.sourceIds.hasAny(['verge']) ? 1 : 0) >= 2)
        && p.authorId == request.auth.uid && p.updatedBy == request.auth.uid && p.updatedAt == request.time && p.revision is int;
    }
    match /portfolioBotSettings/{id} {
      allow get: if id == 'main' && (isPortfolioBlogAdmin() || isBotWorker());
      allow create: if id == 'main' && isPortfolioBlogAdmin() && validBotSettings() && request.resource.data.revision == 1;
      allow update: if id == 'main' && isPortfolioBlogAdmin() && validBotSettings() && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    match /portfolioBotRuns/{id} {
      allow get: if isPortfolioBlogAdmin() || isBotWorker();
      allow list: if (isPortfolioBlogAdmin() && request.query.limit <= 10) || (isBotWorker() && request.query.limit <= 200);
      allow create, update: if isBotWorker();
      allow delete: if false;
    }
    match /portfolioBotDaily/{day} {
      allow get: if isPortfolioBlogAdmin() || isBotWorker();
      allow list, delete: if false;
      allow create, update: if isBotWorker() && day == todayKey() && validDailyPublication();
      function validDailyPublication() {
        let p = request.resource.data;
        let settings = get(/databases/$(database)/documents/portfolioBotSettings/main).data;
        let previous = resource == null ? [] : resource.data.postIds;
        let postId = p.postIds[p.postIds.size() - 1];
        let post = getAfter(/databases/$(database)/documents/portfolioPosts/$(postId)).data;
        return settings.enabled == true && settings.get('autoPublish', false) == true
          && p.keys().hasOnly(['postIds', 'updatedAt']) && p.updatedAt == request.time
          && p.postIds is list && p.postIds.size() == p.postIds.toSet().size()
          && p.postIds.size() == previous.size() + 1 && p.postIds.hasAll(previous)
          && p.postIds.size() <= settings.get('dailyTarget', 2)
          && !exists(/databases/$(database)/documents/portfolioPosts/$(postId))
          && post.status == 'published' && post.publishedAt == request.time
          && post.bot.workerId == request.auth.uid && post.bot.publicationDay == todayKey();
      }
    }
    function validQueuedRequest(uid) {
      let p = request.resource.data;
      return request.auth.uid == uid && p.requestedBy == uid && p.keys().hasAll(['requestedBy', 'requestId', 'status', 'createdAt', 'completedAt', 'resultRunId', 'message'])
        && p.keys().hasOnly(['requestedBy', 'requestId', 'status', 'createdAt', 'completedAt', 'resultRunId', 'message'])
        && p.requestId is string && p.requestId.matches('^[a-zA-Z0-9_-]{16,80}$')
        && p.status == 'queued' && p.createdAt == request.time && p.completedAt == null && p.resultRunId == null
        && p.message is string && p.message.size() <= 320;
    }
    match /portfolioBotRequests/{uid} {
      allow get: if (isPortfolioBlogAdmin() && request.auth.uid == uid) || isBotWorker();
      allow list: if isBotWorker() && request.query.limit <= 5;
      allow create: if isPortfolioBlogAdmin() && validQueuedRequest(uid);
      allow update: if (isPortfolioBlogAdmin() && validQueuedRequest(uid) && resource.data.status in ['done', 'failed'])
        || (isBotWorker() && request.resource.data.requestId == resource.data.requestId && request.resource.data.requestedBy == resource.data.requestedBy && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['queued', 'processing', 'done', 'failed'] && request.resource.data.message is string && request.resource.data.message.size() <= 320);
      allow delete: if false;
    }
    match /portfolioBotStatus/{id} {
      allow get: if id == 'runner' && (isPortfolioBlogAdmin() || isBotWorker());
      allow create, update: if id == 'runner' && isBotWorker()
        && request.resource.data.keys().hasOnly(['workerId', 'lastCheckAt', 'scheduler', 'provider', 'version'])
        && request.resource.data.workerId == request.auth.uid && request.resource.data.lastCheckAt == request.time
        && request.resource.data.scheduler == 'github-actions' && request.resource.data.provider == 'gemini' && request.resource.data.version == 1;
      allow list, delete: if false;
    }
    match /portfolioBotLocks/{id} {
      allow get, create, update, delete: if id == 'runner' && isBotWorker();
      allow list: if false;
    }
    match /portfolioBotTopics/{id} {
      allow get: if isBotWorker();
      allow list: if isBotWorker() && request.query.limit <= 200;
      allow create: if isBotWorker() && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /portfolioBotSourceCache/{id} {
      allow get: if isBotWorker();
      allow create, update: if isBotWorker() && id in ['antara', 'cnn', 'cnbc', 'techcrunch', 'verge', 'antara-news', 'cnn-news', 'cnbc-news']
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 150
        && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
    // Preserve the existing project's default denial for other collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
