{
  "name": "my-portofolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:content": "node --test tests/blog.content.test.mjs",
    "test:dispatch": "node --test tests/bot.dispatch.test.mjs",
    "test:bot": "npm --prefix bot test",
    "dev:bot": "firebase emulators:start --only auth,firestore --project demo-portfolio-blog",
    "bot:run": "node bot/src/index.js",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-portfolio-blog \"node --test tests/blog.rules.test.mjs\"",
    "dev:emulators": "firebase emulators:start --only auth,firestore --project demo-portfolio-blog"
  },
  "dependencies": {
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "firebase": "12.9.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-tools": "^14.27.0",
    "globals": "^15.11.0",
    "tailwindcss": "^4.1.18",
    "vite": "^5.4.10"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
