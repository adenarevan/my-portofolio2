# Optional complete override for another Firebase project.
# With no override, the registered ADENA Web App config is bundled by default.
# Never put a service account here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development only. Never enable for a deployed build.
VITE_FIREBASE_EMULATORS=false

# Optional server-only workflow trigger (Vercel environment or local .env.local).
# Fine-grained GitHub token: only this repository, Actions read/write.
# Never use a VITE_ prefix. Local Vite can also use the existing Git credential helper.
GITHUB_BOT_TOKEN=
